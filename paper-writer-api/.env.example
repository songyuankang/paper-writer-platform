# paper-writer-api 服务地址
PAPER_WRITER_HOST=0.0.0.0
PAPER_WRITER_PORT=8000

# DeepSeek API（论文内容生成模型）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 可选：DeepSeek 或兼容 OpenAI 接口的地址
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=120

# 不配置 DEEPSEEK_API_KEY 时，使用内置示例内容生成（占位内容）
# 一键全文同时生成的小节数；过高可能触发模型限流
PAPER_WRITER_DRAFT_GENERATION_WORKERS=1
